# Salin sebagai .dev.vars untuk dev lokal (wrangler dev)
# Rahasia BOT_TOKEN juga bisa di-set via: npx wrangler secret put BOT_TOKEN
# Semua nilai di bawah CONTOH — jangan commit nilai asli.

BOT_TOKEN=
SECRET_TOKEN=
# SETUP_KEY=opsional_key_khusus_/setwebhook

ADMIN_ID=
ADMIN_USERNAME=
GROUP_ID=
# 0 = unlimited (tanpa batas harian)
FREE_DAILY_LIMIT=0
CHANNEL_ID=
CHANNEL_URL=
COOLDOWN_MS=60000
DONATION_QRIS_URL=
# Maksimal 25 (batas 50 subrequest free plan)
BATCH_SIZE=25
CONVERT_BATCH=25
BROADCAST_BATCH=25
# Stiker loading saat generate. 0 = mati.
LOADING_MS=10000
LOADING_STICKERS=mfload
WEBHOOK_PATH=/webhook
